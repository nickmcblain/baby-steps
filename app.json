{
  "expo": {
    "name": "Baby Steps",
    "slug": "baby-steps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "babysteps",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F4F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nickmcblain.babysteps",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSMicrophoneUsageDescription": "Baby Steps uses the microphone so you can log feeds, sleeps, and nappies hands-free.",
        "NSPhotoLibraryUsageDescription": "Baby Steps uses photos so you can log a bottle, label, or handwritten note.",
        "NSCameraUsageDescription": "Baby Steps uses the camera so you can log a bottle or label."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.nickmcblain.babysteps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F4F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nickmcblain.babysteps",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "@clerk/expo",
      [
        "expo-audio",
        {
          "microphonePermission": "Baby Steps uses the microphone so you can log feeds, sleeps, and nappies hands-free."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Baby Steps uses photos so you can log a bottle, label, or handwritten note."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.nickmcblain.babysteps.widgets",
          "groupIdentifier": "group.com.nickmcblain.babysteps",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "BabyTimerActivity",
              "displayName": "Baby Timer",
              "description": "Shows an active feed or sleep timer on the Lock Screen and Dynamic Island",
              "supportedFamilies": ["systemSmall"]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "804e508a-e06e-4986-82b3-6a293ca7699d"
      }
    },
    "owner": "nickmcblain"
  }
}
