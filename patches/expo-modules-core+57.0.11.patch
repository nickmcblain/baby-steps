+/// Weak reference wrapper that is `@unchecked Sendable` so Xcode 26.3 can schedule emits.
+private final class UncheckedWeakBox<T: AnyObject>: @unchecked Sendable {
+  weak var value: T?
+  init(_ value: T) {
+    self.value = value
+  }
+}
