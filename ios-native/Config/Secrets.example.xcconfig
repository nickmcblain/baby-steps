// Copy to Secrets.xcconfig (gitignored) and fill in.
// Use the same values as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY / EXPO_PUBLIC_CONVEX_URL.

CLERK_PUBLISHABLE_KEY = pk_live_xxxxxxxxxxxxxxxx

// xcconfig treats `//` as a comment, so write the URL with `$()` between the slashes.
CONVEX_URL = https:/$()/your-deployment.convex.cloud

// Apple Developer Team ID that owns com.nickmcblain.babysteps.
DEVELOPMENT_TEAM = XXXXXXXXXX

// Bump above the last EAS build number before archiving.
// CURRENT_PROJECT_VERSION = 42
