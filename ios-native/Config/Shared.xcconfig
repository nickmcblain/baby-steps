// Committed defaults. Real values go in Secrets.xcconfig (gitignored).
// Copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in.

MARKETING_VERSION = 1.0.0
// Must be higher than the last EAS build number for this app on App Store Connect.
CURRENT_PROJECT_VERSION = 1

CLERK_PUBLISHABLE_KEY =
CONVEX_URL =

// Placeholders until the domain is chosen. Secrets.xcconfig can override them.
PRIVACY_POLICY_URL = https:/$()/babysteps.app/privacy
SUPPORT_EMAIL = hello@babysteps.app
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Secrets.xcconfig"

// convex-swift ships an arm64-only simulator slice
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
